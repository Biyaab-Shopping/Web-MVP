# Server (Express)
PORT=5000
SERP_API_KEY=
OPEN_EXCHANGE_APP_ID=

# Public site URL (production) — used for Google Lens image URLs
# APP_URL=https://biyaab.com

# Backend API (development only — CRA dev server runs separately from Express)
# Production builds use .env.production (defaults to /api)
REACT_APP_BACKEND_URL=http://localhost:5000/api

# React app (must be prefixed with REACT_APP_)
REACT_APP_GOOGLE_MAPS_API_KEY=
REACT_APP_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
