# Server (Express)
PORT=5000
SERP_API_KEY=
OPEN_EXCHANGE_APP_ID=

# Public site URL — required for image search on non-Vercel hosts (VPS, Railway, Render, etc.)
# Also recommended on Vercel as your custom domain (e.g. https://biyaab.com)
# APP_URL=https://biyaab.com

# Vercel only: connect Blob store (Storage → Blob → Connect to Project → Redeploy)
# Optional elsewhere: set BLOB_READ_WRITE_TOKEN to use Vercel Blob off-platform

# Backend API (development only — CRA dev server runs separately from Express)
# Production builds use .env.production (defaults to /api)
REACT_APP_BACKEND_URL=http://localhost:5000/api

# React app (must be prefixed with REACT_APP_)
REACT_APP_GOOGLE_MAPS_API_KEY=
REACT_APP_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
